{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "reference/**",
              "reference/screens/**",
              "ui_kits/mobile-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Geist Mono."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-foreground",
      "--background",
      "--border",
      "--card",
      "--card-foreground",
      "--chart-1",
      "--chart-2",
      "--chart-3",
      "--chart-4",
      "--chart-5",
      "--destructive",
      "--destructive-foreground",
      "--font-mono",
      "--font-sans",
      "--foreground",
      "--input",
      "--leading-normal",
      "--leading-snug",
      "--leading-tight",
      "--muted",
      "--muted-foreground",
      "--popover",
      "--popover-foreground",
      "--primary",
      "--primary-foreground",
      "--radius",
      "--radius-lg",
      "--radius-md",
      "--radius-sm",
      "--radius-xl",
      "--ring",
      "--secondary",
      "--secondary-foreground",
      "--sidebar",
      "--sidebar-accent",
      "--sidebar-accent-foreground",
      "--sidebar-border",
      "--sidebar-foreground",
      "--sidebar-primary",
      "--sidebar-primary-foreground",
      "--sidebar-ring",
      "--success",
      "--success-foreground",
      "--text-2xl",
      "--text-3xl",
      "--text-4xl",
      "--text-base",
      "--text-lg",
